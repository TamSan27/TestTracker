# Copy this file to .env and edit the values. Never commit .env.
APP_ENV=development

# false = the app refuses to test localhost / private network addresses (safe default).
# Set to true ONLY on your own computer if you want to test an app running locally.
ALLOW_PRIVATE_URLS=false

# Maximum seconds one test run may take before it is stopped.
RUN_TIMEOUT_SECONDS=180
